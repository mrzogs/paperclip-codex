{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocean.local/contracts/factual-qualification/v1",
  "$defs": {
    "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,159}$"},
    "instanceId": {"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/_-]*$"},
    "legacyReference": {
      "type":"object","additionalProperties":false,"required":["task_id","bundle_path","bundle_sha256"],
      "properties":{"task_id":{"type":"string"},"bundle_path":{"type":"string"},"bundle_sha256":{"$ref":"#/$defs/sha256"}}
    },
    "qualificationReference": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","qualification_id","qualification_role","bundle_path","bundle_sha256"],
      "properties":{
        "schema_version":{"const":"ocean-factual-qualification-reference/v1"},
        "qualification_id":{"$ref":"#/$defs/id"},"qualification_role":{"enum":["source","strategy"]},
        "bundle_path":{"type":"string"},"bundle_sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "reference": {"oneOf":[{"$ref":"#/$defs/legacyReference"},{"$ref":"#/$defs/qualificationReference"}]},
    "receipt": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","qualification_id","qualification_role","parent_task_id","owner","status","scope","evidence_classification","target_execution_instance_id","created_at_utc","baseline","facts_member","attestation_member"],
      "properties":{
        "schema_version":{"const":"ocean-factual-qualification/v1"},
        "qualification_id":{"$ref":"#/$defs/id"},"qualification_role":{"enum":["source","strategy"]},
        "parent_task_id":{"const":"S30.2"},"owner":{"enum":["Telemetry Data Logger","Telemetry Logger","VWAP Strategy"]},
        "status":{"const":"PASS"},"scope":{"const":"FACTS_ONLY_NOT_TASK_COMPLETION"},
        "evidence_classification":{"enum":["ACTUAL_SOURCE_OBSERVATION","ACTUAL_LOADED_STRATEGY_ATTESTATION"]},
        "target_execution_instance_id":{"$ref":"#/$defs/instanceId"},"created_at_utc":{"type":"string","format":"date-time"},
        "baseline":{"$ref":"#/$defs/legacyReference"},
        "facts_member":{"const":"artifacts/facts.json"},"attestation_member":{"const":"artifacts/observation-evidence.json"}
      },
      "allOf":[
        {"if":{"properties":{"qualification_role":{"const":"source"}}},"then":{"properties":{"owner":{"enum":["Telemetry Data Logger","Telemetry Logger"]},"evidence_classification":{"const":"ACTUAL_SOURCE_OBSERVATION"}}}},
        {"if":{"properties":{"qualification_role":{"const":"strategy"}}},"then":{"properties":{"owner":{"const":"VWAP Strategy"},"evidence_classification":{"const":"ACTUAL_LOADED_STRATEGY_ATTESTATION"}}}}
      ]
    },
    "attestation": {
      "type":"object","additionalProperties":false,
      "required":["schema_version","qualification_id","observer","observed_at_utc","method","synthetic","source_artifacts"],
      "properties":{
        "schema_version":{"const":"ocean-factual-observation-evidence/v1"},"qualification_id":{"$ref":"#/$defs/id"},
        "observer":{"type":"string","minLength":1,"maxLength":200},"observed_at_utc":{"type":"string","format":"date-time"},
        "method":{"type":"string","minLength":1,"maxLength":2000},"synthetic":{"const":false},
        "source_artifacts":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,
          "items":{"type":"object","additionalProperties":false,"required":["member","sha256"],
            "properties":{"member":{"type":"string","pattern":"^artifacts/observations/"},"sha256":{"$ref":"#/$defs/sha256"}}}}
      }
    }
  },
  "$ref":"#/$defs/reference"
}
