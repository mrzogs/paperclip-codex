{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ocean.local/contracts/service-identity/v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","identity","operational_ingestion","live_real","approval_authority"],
  "properties":{
    "schema_version":{"const":"ocean-service-identity/v1"},"operational_ingestion":{"const":"OFF"},"live_real":{"const":"DISABLED"},"approval_authority":{"const":false},
    "identity":{
      "type":"object","additionalProperties":false,
      "required":["id","role","namespace","audience","scopes","strategy_ids","instance_ids","factual_binding_hash","credential_version","expires_at_utc"],
      "properties":{
        "id":{"type":"string","minLength":1},"role":{"enum":["BRAIN","TELEMETRY","STRATEGY"]},
        "namespace":{"enum":["TEST","OPERATIONAL"]},"audience":{"enum":["Ocean workflow TEST","Ocean workflow operational v1"]},
        "scopes":{"type":"array","minItems":1,"items":{"type":"string"}},
        "strategy_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
        "instance_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
        "factual_binding_hash":{"type":["string","null"],"pattern":"^sha256:[a-f0-9]{64}$"},
        "credential_version":{"type":"integer","minimum":1},"expires_at_utc":{"type":"string","format":"date-time"}
      },
      "allOf":[
        {"if":{"properties":{"namespace":{"const":"TEST"}}},"then":{"properties":{"audience":{"const":"Ocean workflow TEST"},"factual_binding_hash":{"const":null}}}},
        {"if":{"properties":{"namespace":{"const":"OPERATIONAL"}}},"then":{"properties":{"audience":{"const":"Ocean workflow operational v1"},"factual_binding_hash":{"type":"string"},"strategy_ids":{"maxItems":1},"instance_ids":{"maxItems":1}}}}
      ]
    }
  }
}
