      "package_sha256",
      "instance_executable",
      "operation_scope",
      "acquired_utc",
      "expires_utc",
      "prior_receipt_hash"
    ],
    "receipt_excluded_fields": [
      "receipt_hash",
      "registry_comment_id",
      "registry_body_sha256"
    ]
  },
  "audit_mirror": {
    "authoritative": false,
    "absent_registry_comment_id": null,
    "absent_registry_body_sha256": null,
    "receipt_hash_includes_mirror": false
  },
