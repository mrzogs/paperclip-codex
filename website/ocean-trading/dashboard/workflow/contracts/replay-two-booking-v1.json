  "operation_scope": [
    "Stage",
    "VerifySelection",
    "Rollback"
  ],
  "routes": {
    "register": "POST /api/workflow/operational/v1/replay-two-bookings",
    "exact": "GET /api/workflow/operational/v1/replay-two-bookings/{booking_id}",
    "current": "GET /api/workflow/operational/v1/replay-two-bookings/current?resource_key=sierra-replay-two%3Aprimary",
    "renew": "POST /api/workflow/operational/v1/replay-two-bookings/renew",
    "release": "POST /api/workflow/operational/v1/replay-two-bookings/{booking_id}/release",
    "revoke": "POST /api/workflow/operational/v1/replay-two-bookings/{booking_id}/revoke"
  },
  "authorization": {
    "register_release_scope": "booking.issue",
    "read_scope": "booking.read",
    "register_release_actor": "Exact configured OPERATIONAL STRATEGY identity and owner_project binding",
    "approval_binding": "Exact protected-config identity_id, owner_project, approval_id, approval_snapshot_sha256, package_sha256 and expires_utc match; lease expiry cannot exceed approval expiry",
    "revoke_actor": "Authenticated Wayne browser identity",
    "renewal": "BOOKING_RENEWAL_UNAVAILABLE"
  },
  "approval_authority": {
    "live_status_authoritative": false,
    "acquire_pin": "The protected config binding pins approval identity, snapshot hash, package hash and expiry at acquisition.",
    "client_gate": "An ACTIVE booking never authorizes a physical mutation by itself. Stage, VerifySelection and Rollback clients must independently re-read the protected live approval immediately before and after each mutation and fail closed on any change or revocation.",
    "booking_revocation": "Wayne or the supervised Ocean governance path must also revoke the booking when approval is withdrawn."
  },
  "fresh_read": {
    "request_header": "X-Ocean-Booking-Read-Nonce",
    "response_header": "X-Ocean-Booking-Read-Nonce",
    "value_format": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
    "client_rule": "Generate a new nonce for every exact/current GET and reject a missing or unequal echo.",
    "server_cache_control": "no-store",
    "response_signed": false,
    "server_observation_field": "observed_at_utc",
    "client_max_request_duration_ms": 5000,
    "client_max_observation_age_ms": 5000,
    "client_clock_skew_ms": 1000,
    "receipt_hash_includes_nonce": false
  },
  "current_semantics": {
    "latest_fence_always_present_after_first_acquisition": true,
    "active_and_terminal_shape": "The current field contains the latest immutable booking fence and effective_status for ACTIVE, RELEASED, REVOKED or EXPIRED. It is never null after the first acquisition.",
    "restart_recovery": "A freshly restarted authorized client obtains expected_prior_generation and expected_prior_receipt_hash from current.generation and current.receipt_hash before a successor acquisition.",
    "no_booking": "The route returns BOOKING_NOT_FOUND before the first acquisition."
  },
  "hashing": {
    "algorithm": "sha256",
    "format": "^sha256:[0-9a-f]{64}$",
    "canonicalization": "Recursively sort object keys, preserve array order, UTF-8 JSON.stringify-equivalent encoding, no insignificant whitespace.",
    "receipt_core_fields": [
      "schema",
      "booking_id",
      "resource_key",
      "generation",
      "status",
      "owner_project",
      "owner_agent_id",
      "approval_id",
